    "check:lines-contract": "node scripts/check-lines-contract.mjs",
    "check:time-usage-contract": "node scripts/check-time-usage-contract.mjs",
    "check:rating-bands-contract": "node scripts/check-rating-bands-contract.mjs",
    "check:analysis-runs-contract": "node scripts/check-analysis-runs-contract.mjs",
    "check:games-list-contract": "node scripts/check-games-list-contract.mjs",
    "check:insights-contract": "node scripts/check-insights-contract.mjs",
