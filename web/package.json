  },
  "devDependencies": {
    "@types/node": "24",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
